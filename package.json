{
  "name": "chrome-design",
  "displayName": "Chrome Design",
  "version": "0.1.0",
  "private": true,
  "description": "Inspect, comment on and draw over any live web page, then export one self-contained HTML handoff for an AI coding/design agent.",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "demo": "vite --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint && biome check .",
    "lint:fix": "biome check --write . && oxlint --fix",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs",
    "demo:build": "vite build --config vite.demo.config.ts"
  },
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "react": "19",
    "react-dom": "19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
